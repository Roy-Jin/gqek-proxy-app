# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is ignored by git; VITE_* values become part of the built bundle.

# Optional read-only GitHub token for release checks.
# With a token the rate limit is 5000 requests/hour per account, without it 60/hour per IP.
# Leave empty to keep the anonymous public request.
VITE_GITHUB_TOKEN=
